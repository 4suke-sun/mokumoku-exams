# 環境固有の値は、このファイルをコピーした .env(gitignore 済み)に書く。
# ここにはプレースホルダーだけを書き、実値は書かない。
# 変数の一覧と検査は packages/infra/lib/config.ts にある。

# --- cdkd(AWS SDK)が読む ---
AWS_PROFILE=<プロファイル名>
AWS_REGION=<リージョン>

# --- 必須 ---
# Lambda Web Adapter のレイヤーの ARN(バージョン付き)。デプロイ先のリージョンのものを、公式の案内から調べて書く
WEB_ADAPTER_LAYER_ARN=<レイヤーの ARN>
# CloudFront がオリジンへ付ける合言葉(32 文字以上の、推測されにくいランダムな文字列)
ORIGIN_VERIFY_VALUE=<ランダムな文字列>

# --- 省略できる ---
# リソース名の先頭に付ける文字列(既定: mokumoku-exams)
# STACK_PREFIX=

# アラームの通知先のメールアドレス(なければ、通知の購読は作らない。デプロイ後に届く確認のメールで購読を承認する)
# ALARM_EMAIL=

# アプリの Lambda の同時実行の上限(1〜1000 の整数)。なければ付けない。アカウントの同時実行の上限に、予約しない分を 100 以上残せる値にする(上限が 1000 なら 900 まで)
# APP_RESERVED_CONCURRENCY=10

# 公開の URL の起点(https://<ホスト>。末尾のスラッシュなし)。sitemap と robots の絶対 URL に使う。なければ sitemap は空
# SITE_URL=https://example.com

# プッシュ通知の公開鍵、秘密鍵のパラメーターの名前、連絡先。3 つそろえて書く(なければ、通知の送信の仕組みを作らない)
# 鍵は `npx web-push generate-vapid-keys` で作る。秘密鍵の値は、ここには書かない
# (SSM Parameter Store の SecureString に置き、その名前を書く。docs/app/infra.md)
# VAPID_PUBLIC_KEY=<VAPID の公開鍵>
# VAPID_PRIVATE_KEY_PARAMETER=/<パラメーターの名前>
# 送信者の連絡先(mailto: か https:// で始まる)
# VAPID_SUBJECT=mailto:admin@example.com
# 独自ドメイン(なければ、CloudFront の既定のドメイン(xxxx.cloudfront.net)で配信する)
# 配信に使うドメイン名。DOMAIN_NAME と CERTIFICATE_ARN は、そろえて設定する
# DOMAIN_NAME=app.example.com
# DOMAIN_NAME の証明書(ACM)の ARN。CloudFront で使うため、us-east-1 で発行したもの
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:<アカウント ID>:certificate/<証明書の ID>
# Route 53 のホストゾーンの ID。あれば、DOMAIN_NAME から CloudFront へのレコードを作る(なければ、DNS は自分で設定する)
# HOSTED_ZONE_ID=<ホストゾーンの ID>
