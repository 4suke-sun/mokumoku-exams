{
  "workDir": "pipeline-work",
  "ledgerDir": "packages/pipeline/ledger",
  "factsDir": "packages/pipeline/facts",
  "provenanceDir": "packages/pipeline/provenance",
  "decisionsDir": "packages/pipeline/decisions",
  "plansDir": "packages/pipeline/plans",
  "examsFile": "data/exams.json",
  "maxItemsPerRun": 20,
  "fetch": {
    "perHostIntervalMs": 2000,
    "perHostConcurrency": 1,
    "maxConcurrency": 4,
    "timeoutMs": 15000,
    "maxBytes": 5000000,
    "maxRedirects": 5,
    "userAgent": "mokumoku-exams-pipeline/1.0 (source collector)"
  },
  "cache": {
    "retentionDays": 30,
    "maxBytes": 500000000
  },
  "facts": {
    "maxAttempts": 3,
    "sampleSeed": 1,
    "samplePerDomain": 3
  },
  "draft": {
    "maxAttempts": 3,
    "maxPerRequest": 5,
    "maxFactsPerRequest": 12,
    "maxRounds": 3,
    "similarity": { "duplicate": 0.85, "hold": 0.6 }
  },
  "candidates": {
    "maxPerItem": 5,
    "maxAttempts": 3
  },
  "review": {
    "mode": "full",
    "rate": 0.3,
    "seed": 1,
    "nearHoldMargin": 0.15,
    "highRiskScore": 2,
    "maxRejectRate": 0.2,
    "minDecisions": 5,
    "autoApprove": ["AWS-AIB-C01", "AWS-DVA-C02"]
  },
  "eval": {
    "seed": 1,
    "perKind": 3,
    "maxAttempts": 3,
    "targets": {
      "detectionOverall": 0.9,
      "detectionPerKind": 0.8,
      "falsePositiveMax": 0.2
    }
  },
  "verify": {
    "maxAttempts": 3
  },
  "judge": {
    "maxAttempts": 3,
    "eval": {
      "seed": 1,
      "perKind": 3,
      "targets": {
        "detectionOverall": 0.9,
        "detectionPerKind": 0.8,
        "falsePositiveMax": 0.2
      }
    }
  },
  "plan": {
    "targetMultiplier": 3,
    "difficultyMix": { "easy": 0.3, "medium": 0.5, "hard": 0.2 },
    "typeMix": { "single": 0.75, "multiple": 0.2, "free-text": 0.05 },
    "overrides": {
      "AWS-AIB-C01": { "targetTotal": 340, "typeMix": { "single": 1, "multiple": 0, "free-text": 0 } },
      "AWS-CLF-C02": { "targetTotal": 200 },
      "AWS-DVA-C02": {
        "targetTotal": 457,
        "services": { "minPerService": 2, "maxShare": 0.15, "minMultiServiceShare": 0.3 }
      }
    }
  },
  "checks": {
    "freshnessDays": 365
  }
}
