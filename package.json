{
  "name": "mokumoku-exams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev -w @mokumoku-exams/app",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:all": "node scripts/test-all.ts",
    "test:e2e": "npm run test:e2e -w @mokumoku-exams/app",
    "pipeline": "npm run pipeline -w @mokumoku-exams/pipeline --",
    "status": "node scripts/status.ts",
    "release": "node scripts/release.ts",
    "verify": "node scripts/verify.ts",
    "lessons": "node scripts/lessons.ts",
    "mask": "node scripts/mask-output.ts",
    "metrics": "node scripts/metrics.ts",
    "agent-cost": "node scripts/agent-cost.ts",
    "check:branch": "node scripts/check-branch.ts",
    "check:commit": "node scripts/check-commit-secrets.ts",
    "check:release-notes": "node scripts/check-release-notes.ts",
    "check:lessons": "node scripts/check-lessons.ts",
    "check:test-titles": "node scripts/check-test-titles.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:env": "node scripts/check-env-contract.ts",
    "check:pr-closes": "node scripts/check-pr-closes.ts",
    "check:boundary": "node scripts/check-pipeline-boundary.ts",
    "check:retired-ids": "node scripts/check-retired-ids.ts",
    "check:unpublished-bundle": "node scripts/check-unpublished-bundle.ts data packages/app/.next",
    "validate:data": "node scripts/validate-exam-data.ts && node scripts/validate-curriculum-data.ts && node scripts/validate-notebook-data.ts && node scripts/validate-code-drill-data.ts && node scripts/validate-summary-data.ts && node scripts/validate-help-data.ts",
    "build:lambda": "node scripts/build-lambda-asset.ts",
    "synth": "npm run synth -w @mokumoku-exams/infra"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@mokumoku-exams/data-schema": "*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
