{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(gh api *)", "Bash(gh issue edit *)"],
    "ask": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(*gh issue edit*--body*)",
      "Bash(*gh issue edit*-b*)",
      "Bash(*gh issue edit*-F*)",
      "Bash(*gh issue edit*--title*)",
      "Bash(*gh issue edit*-t*)",
      "Bash(*gh issue edit*-project*)",
      "Bash(*gh issue edit*--repo*)",
      "Bash(*gh issue edit*-R*)",
      "Bash(*gh issue edit*$*)",
      "Bash(*gh issue edit*`*)",
      "Bash(*gh api*-X*)",
      "Bash(*gh api*--method*)",
      "Bash(*gh api*-f*)",
      "Bash(*gh api*-F*)",
      "Bash(*gh api*--field*)",
      "Bash(*gh api*--raw-field*)",
      "Bash(*gh api*--input*)",
      "Bash(*gh api*$*)",
      "Bash(*gh api*`*)",
      "Bash(gh label create*)",
      "Bash(*scripts/release.ts*)",
      "Bash(npm*run*release*)",
      "Bash(*cdkd*deploy*)",
      "Bash(npm*run*deploy*)",
      "Bash(*cdkd*destroy*)",
      "Bash(npm*run*destroy*)",
      "Bash(*scripts/post-issues.ts*)"
    ],
    "deny": ["Bash(git*--force*)", "Bash(git*--no-verify*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/approval-hook.ts\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
