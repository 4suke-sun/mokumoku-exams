+import { describe, expect, it } from "vitest";
+import { sumTokens } from "./sum-tokens.ts";
+
+describe("sumTokens", () => {
+  it("記録が空_どれも 0 を返す", () => {
+    expect(sumTokens([])).toEqual({ input: 0, output: 0 });
+  });
+
+  it("記録が 2 件_種類ごとに足す", () => {
+    expect(
+      sumTokens([
+        { input: 10, output: 2 },
+        { input: 5, output: 3 },
+      ]),
+    ).toEqual({ input: 15, output: 5 });
+  });
+});
