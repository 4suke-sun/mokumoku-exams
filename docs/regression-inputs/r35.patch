+/** 応答ごとのトークンの記録を、種類ごとに足し合わせる。記録が空なら、どれも 0 を返す。 */
+export interface TokenUsage {
+  input: number;
+  output: number;
+}
+
+export function sumTokens(records: readonly TokenUsage[]): TokenUsage {
+  return records.reduce((acc, r) => ({ input: acc.input + r.input, output: acc.output + r.output }), {
+    input: 0,
+    output: 0,
+  });
+}
