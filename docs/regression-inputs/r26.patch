+import { describe, expect, it } from "vitest";
+import { guardReadonly } from "./readonly-guard.ts";
+
+describe("guardReadonly", () => {
+  it("読み取りのコマンドだけ_通す", () => {
+    expect(guardReadonly("cat a.txt; grep foo b.txt")).toBeNull();
+  });
+
+  it("区切りのあとに許可の外のコマンド_止める", () => {
+    expect(guardReadonly("cat a.txt && rm b.txt")).toBe("許可の外のコマンド");
+  });
+
+  it("書き出しの記号を含む_止める", () => {
+    expect(guardReadonly("cat a.txt > b.txt")).toBe("ファイルへの書き出し");
+  });
+});
