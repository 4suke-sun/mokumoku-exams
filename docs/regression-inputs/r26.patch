@@ -0,0 +1,25 @@
+/**
+ * 読み取り役の Bash のコマンドから、書き込みにあたるものを止める。
+ * 決まりは docs/readonly-guard.md。
+ */
+
+/** 先頭の語として許すコマンド。 */
+const ALLOWED = new Set(["cat", "grep", "head", "ls", "wc"]);
+
+/** コマンドを、区切りで部分に分ける。 */
+export function splitCommand(command: string): string[] {
+  return command
+    .split(/;|&&/)
+    .map((part) => part.trim())
+    .filter((part) => part !== "");
+}
+
+/** 止めるときは理由を、通すときは null を返す。 */
+export function guardReadonly(command: string): string | null {
+  for (const part of splitCommand(command)) {
+    const head = part.split(/\s+/)[0] ?? "";
+    if (!ALLOWED.has(head)) return "許可の外のコマンド";
+    if (part.includes(">")) return "ファイルへの書き出し";
+  }
+  return null;
+}
