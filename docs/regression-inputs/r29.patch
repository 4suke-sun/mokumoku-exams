+/**
+ * Bash の許可のコマンドを確かめる対象の役。フックの入力の `agent_type` で見分ける。
+ * 対象の外の役(メイン、検査役、作問パイプラインの役)は、この判定では止めない。
+ */
+const CHECKED_ROLES = new Set(["commit-writer", "draft-writer"]);
+
+/** この役の Bash を、許可のコマンドの判定にかけるか。 */
+export function isCheckedRole(agentType: string | undefined): boolean {
+  return agentType !== undefined && CHECKED_ROLES.has(agentType);
+}
