+import { describe, expect, it } from "vitest";
+import { isCheckedRole } from "./writer-bash-scope.ts";
+
+describe("isCheckedRole", () => {
+  it("作成役_判定にかける", () => {
+    expect(isCheckedRole("commit-writer")).toBe(true);
+    expect(isCheckedRole("draft-writer")).toBe(true);
+  });
+
+  it("作成役でない役か役がない_判定にかけない", () => {
+    expect(isCheckedRole("question-drafter")).toBe(false);
+    expect(isCheckedRole(undefined)).toBe(false);
+  });
+});
