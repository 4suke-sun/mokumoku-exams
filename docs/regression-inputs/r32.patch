+import { existsSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { finishRequest } from "./request-cleanup.ts";
+
+describe("finishRequest", () => {
+  it("取り込んだ依頼_出力のファイルを消す", () => {
+    const dir = mkdtempSync(join(tmpdir(), "request-cleanup-"));
+    writeFileSync(join(dir, "a.request.json"), "{}");
+    writeFileSync(join(dir, "a.output.json"), "{}");
+
+    finishRequest(dir, "a");
+
+    // 出力のファイルは消え、依頼のファイルは出し直しに使うため残る
+    expect(existsSync(join(dir, "a.output.json"))).toBe(false);
+    expect(existsSync(join(dir, "a.request.json"))).toBe(false);
+  });
+});
