+import { existsSync, rmSync } from "node:fs";
+import { join } from "node:path";
+
+/**
+ * 出力を取り込んだ依頼を片づける。依頼のファイルと出力のファイルを、どちらも消す。
+ * 取り込みに失敗した依頼は、この関数を呼ばない(出し直しのために残す)。
+ */
+export function finishRequest(dir: string, name: string): void {
+  for (const file of [`${name}.request.json`, `${name}.output.json`]) {
+    const path = join(dir, file);
+    if (existsSync(path)) rmSync(path);
+  }
+}
